<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#354B76" />
            <stroke android:width="1dp" android:color="@color/cyan" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#E61A2947" android:endColor="#E60D172B" />
            <stroke android:width="1dp" android:color="#806080AE" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
