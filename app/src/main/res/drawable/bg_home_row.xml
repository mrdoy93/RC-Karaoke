<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#2C315B" android:endColor="#193C63" />
            <stroke android:width="1dp" android:color="@color/cyan" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#E6121B31" android:endColor="#E615223B" />
            <stroke android:width="1dp" android:color="#4D45618F" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
