<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#55231462" />
            <stroke android:width="7dp" android:color="@color/gold" />
        </shape>
    </item>
    <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="95dp" android:startColor="#663F8CFF" android:centerColor="#331B2C70" android:endColor="#CC0B1230" />
            <stroke android:width="2dp" android:color="#884FE4FF" />
        </shape>
    </item>
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
