<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#F0182846" android:centerColor="#F0121B31" android:endColor="#F00C1427" />
            <stroke android:width="1dp" android:color="#684C78AF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#AFA43CFF" android:endColor="#AF34CFFF" />
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp" />
        </shape>
    </item>
</layer-list>
