<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F0162341" android:endColor="#F01A3153" />
            <stroke android:width="2dp" android:color="@color/cyan" />
            <corners android:radius="13dp" />
            <padding android:left="13dp" android:top="5dp" android:right="13dp" android:bottom="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#E6111A31" android:endColor="#E6172442" />
            <stroke android:width="1dp" android:color="#596493C8" />
            <corners android:radius="13dp" />
            <padding android:left="14dp" android:top="6dp" android:right="14dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
