<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7428D8" android:endColor="#156FD0" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#A745FF" android:endColor="#268DFF" />
            <stroke android:width="1dp" android:color="#99BDEBFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
