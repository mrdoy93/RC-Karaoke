<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#0A315A" android:endColor="#124F88" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#164A7A" android:endColor="#2276AE" />
            <stroke android:width="1dp" android:color="#998BD6FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
