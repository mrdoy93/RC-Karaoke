<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#263B63" />
            <stroke android:width="1dp" android:color="@color/cyan" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D7192743" android:endColor="#D710192E" />
            <stroke android:width="1dp" android:color="#4F3F5B83" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
