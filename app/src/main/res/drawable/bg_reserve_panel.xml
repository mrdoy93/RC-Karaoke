<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#FA061225"
                android:centerColor="#FA0B2748"
                android:endColor="#FA071A33" />
            <stroke android:width="1dp" android:color="#6B2F6FA8" />
            <corners android:topLeftRadius="22dp" android:bottomLeftRadius="22dp" />
        </shape>
    </item>
    <item android:gravity="left" android:width="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#991D5D9B" android:endColor="#CC0A2E57" />
            <corners android:topLeftRadius="22dp" android:bottomLeftRadius="22dp" />
        </shape>
    </item>
</layer-list>
