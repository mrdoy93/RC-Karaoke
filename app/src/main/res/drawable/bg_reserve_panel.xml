<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#FA08101F"
                android:centerColor="#FA101B35"
                android:endColor="#FA080E1C" />
            <stroke android:width="1dp" android:color="#6B54D8FF" />
            <corners android:topLeftRadius="22dp" android:bottomLeftRadius="22dp" />
        </shape>
    </item>
    <item android:gravity="left" android:width="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#992F8CFF" android:endColor="#CCB34DFF" />
            <corners android:topLeftRadius="22dp" android:bottomLeftRadius="22dp" />
        </shape>
    </item>
</layer-list>
