<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#66123968" android:endColor="#661D5D9B" />
            <stroke android:width="2dp" android:color="@color/cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <stroke android:width="1dp" android:color="@color/violet" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
