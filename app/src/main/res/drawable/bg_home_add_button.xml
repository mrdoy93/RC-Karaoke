<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="0" android:startColor="#0A315A" android:endColor="#124F88" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#164A7A" android:endColor="#2276AE" />
            <stroke android:width="1dp" android:color="#B38BD6FF" />
        </shape>
    </item>
</selector>
