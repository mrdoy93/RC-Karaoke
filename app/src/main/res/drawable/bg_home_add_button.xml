<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="0" android:startColor="#7026C9" android:endColor="#146AC5" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#B23CFF" android:endColor="#2F9BFF" />
            <stroke android:width="1dp" android:color="#B3C8F5FF" />
        </shape>
    </item>
</selector>
