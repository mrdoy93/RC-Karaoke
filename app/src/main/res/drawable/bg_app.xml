<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#050914"
                android:centerColor="#081A33"
                android:endColor="#0B2748" />
        </shape>
    </item>
    <item android:gravity="top|right" android:width="460dp" android:height="460dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="230dp"
                android:startColor="#301D5D9B"
                android:centerColor="#141D5D9B"
                android:endColor="#001D5D9B" />
        </shape>
    </item>
    <item android:gravity="bottom|left" android:width="390dp" android:height="390dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="195dp"
                android:startColor="#25124A78"
                android:centerColor="#10124A78"
                android:endColor="#00124A78" />
        </shape>
    </item>
    <item android:gravity="top" android:height="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00124A78" android:centerColor="#B64FCBFF" android:endColor="#001D5D9B" />
        </shape>
    </item>
</layer-list>
