<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/playerStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start">

    <SurfaceView
        android:id="@+id/backgroundVideoSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <FrameLayout
            android:id="@+id/playerSongTitleContainer"
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:clipChildren="true"
            android:clipToPadding="true">

            <TextView
                android:id="@+id/playerSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:ellipsize="none"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:shadowColor="#CC001825"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="Song Title — Artist"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/playerHeaderControls"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <Button
            android:id="@+id/playerHomeButton"
            style="@style/Button.Secondary"
            android:layout_width="78dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:text="‹ Home" />

        <FrameLayout
            android:id="@+id/playerReserveControl"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="5dp"
            android:clickable="true"
            android:contentDescription="Reserved songs"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/reserved_song_icon" />

            <TextView
                android:id="@+id/playerReserveCount"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_count_badge"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/playerReserveBadge"
            android:layout_width="180dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card"
            android:ellipsize="marquee"
            android:gravity="start|center_vertical"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="Next: none"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|center_horizontal"
        android:paddingBottom="12dp"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.example.offlinekaraoke.OutlinedTextView
                android:id="@+id/currentLyricOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="34sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="The current lyric appears here"
                android:textColor="#FF000000"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentLyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="34sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="The current lyric appears here"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <com.example.offlinekaraoke.OutlinedTextView
                android:id="@+id/nextLyricOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="27sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="The next lyric appears here"
                android:textColor="#FF000000"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nextLyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="27sp"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="The next lyric appears here"
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerProgressControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <SeekBar
            android:id="@+id/songProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/violet"
            android:thumbTint="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/elapsedTime"
                style="@style/Text.Muted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:00" />

            <TextView
                android:id="@+id/totalTime"
                style="@style/Text.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:56" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

    </FrameLayout>

    <ImageButton
        android:id="@+id/reservePanelHandle"
        android:layout_width="58dp"
        android:layout_height="68dp"
        android:layout_gravity="end|center_vertical"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="@string/open_swipe_panel"
        android:elevation="0dp"
        android:focusable="true"
        android:paddingStart="13dp"
        android:paddingTop="17dp"
        android:paddingEnd="10dp"
        android:paddingBottom="17dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_keyboard" />

    <View
        android:id="@+id/reservePanelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#52000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/reservePanelLegacy"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_reserve_panel"
        android:clickable="true"
        android:elevation="18dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.75"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="0.55"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/reserved_song_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:singleLine="true"
                android:text="RESERVE STUDIO"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Queue &amp; performance"
                    android:textColor="@color/cyan"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/backgroundVideoButton"
                style="@style/Button.PanelControl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1.1"
                android:contentDescription="Choose background video"
                android:text="BG Auto"
                android:textSize="10sp" />

            <Button
                android:id="@+id/reserveCloseButton"
                style="@style/Button.PanelControl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="0.65"
                android:contentDescription="Close reserve panel"
                android:text="×"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reservationPerformanceControls"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="2.45"
            android:background="@drawable/bg_panel_section"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3"
                android:gravity="start|center_vertical"
                android:letterSpacing="0.12"
                android:paddingStart="4dp"
                android:text="PERFORMANCE CONTROLS"
                android:textColor="@color/cyan"
                android:textSize="8sp"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="1sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel_display"
                    android:orientation="vertical"
                    android:padding="2dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.32"
                        android:gravity="center"
                        android:text="KEY"
                        android:textColor="@color/muted"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/keyDownButton"
                            style="@style/Button.PanelControl"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.65"
                            android:text="−"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/keyValue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.3"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="9sp"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeStepGranularity="1sp" />

                        <Button
                            android:id="@+id/keyUpButton"
                            style="@style/Button.PanelControl"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.65"
                            android:text="+"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel_display"
                    android:orientation="vertical"
                    android:padding="2dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0.32"
                        android:gravity="center"
                        android:text="TEMPO"
                        android:textColor="@color/muted"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/tempoDownButton"
                            style="@style/Button.PanelControl"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.65"
                            android:text="−"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tempoValue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.3"
                            android:gravity="center"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="100%"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="8sp"
                            android:autoSizeMaxTextSize="17sp"
                            android:autoSizeStepGranularity="1sp" />

                        <Button
                            android:id="@+id/tempoUpButton"
                            style="@style/Button.PanelControl"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.65"
                            android:text="+"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="0.58"
                android:background="@drawable/bg_panel_display"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:gravity="start|center_vertical"
                    android:text="MIC"
                    android:textColor="@color/muted"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/micVolumeDownButton"
                    style="@style/Button.PanelControl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.65"
                    android:text="−"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/micVolumeValue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="50%"
                    android:textColor="@color/cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="17sp"
                    android:autoSizeStepGranularity="1sp" />

                <Button
                    android:id="@+id/micVolumeUpButton"
                    style="@style/Button.PanelControl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.65"
                    android:text="+"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="0.72"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/restartButton"
                    style="@style/Button.PanelControl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:text="Restart" />

                <Button
                    android:id="@+id/pauseButton"
                    style="@style/Button.PanelPrimary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:text="Pause" />

                <Button
                    android:id="@+id/finishButton"
                    style="@style/Button.PanelDanger"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:text="Finish" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="0.9"
            android:background="@drawable/bg_panel_section"
            android:orientation="vertical"
            android:padding="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3"
                android:gravity="start|center_vertical"
                android:letterSpacing="0.12"
                android:paddingStart="4dp"
                android:text="FIND A SONG"
                android:textColor="@color/cyan"
                android:textSize="8sp"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="1sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/reserveNumberModeButton"
                    style="@style/Button.PanelPrimary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:text="By number" />

                <Button
                    android:id="@+id/reserveTitleModeButton"
                    style="@style/Button.PanelControl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:text="By title" />
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/reserveTitleSearch"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="0.7"
            android:background="@drawable/bg_panel_display"
            android:hint="Search title or artist"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/reserveTitleKeyboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1.8"
            android:background="@drawable/bg_panel_section"
            android:baselineAligned="false"
            android:orientation="vertical"
            android:padding="2dp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/reserveTitleResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="3.8"
            android:divider="@color/stroke"
            android:dividerHeight="1dp"
            android:fadeScrollbars="false"
            android:fastScrollEnabled="true"
            android:overScrollMode="never"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reserveNumberDisplay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="0.72"
            android:background="@drawable/bg_panel_display"
            android:gravity="center"
            android:text="------"
            android:textColor="@color/cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeStepGranularity="1sp" />

        <TextView
            android:id="@+id/reserveSongPreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.42"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Enter a song number"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/reserveKeypad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.55"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button android:id="@+id/reserveDigit1" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="1" android:textSize="15sp" />
                <Button android:id="@+id/reserveDigit2" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="2" android:textSize="15sp" />
                <Button android:id="@+id/reserveDigit3" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="3" android:textSize="15sp" />
                <Button android:id="@+id/reserveDigit4" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="4" android:textSize="15sp" />
                <Button android:id="@+id/reserveDigit5" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="5" android:textSize="15sp" />
                <Button android:id="@+id/reserveDigit6" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="6" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button android:id="@+id/reserveDigit7" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="7" android:textSize="15sp" />
                <Button android:id="@+id/reserveDigit8" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="8" android:textSize="15sp" />
                <Button android:id="@+id/reserveDigit9" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="9" android:textSize="15sp" />
                <Button android:id="@+id/reserveDigit0" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:text="0" android:textSize="15sp" />
                <Button android:id="@+id/reserveClearButton" style="@style/Button.PanelDanger" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1.3" android:text="Clear" android:textSize="9sp" />
                <Button android:id="@+id/reserveBackspaceButton" style="@style/Button.PanelControl" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1.3" android:text="&#x232B;" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/reserveSubmitButton"
            style="@style/Button.PanelPrimary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="0.72"
            android:text="Reserve song"
            android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/reserve_panel_design" />
</FrameLayout>
