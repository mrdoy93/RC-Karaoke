<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scoreScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stage"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#AA4FE4FF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        android:singleLine="true"
        android:text="GREAT PERFORMANCE!"
        android:textColor="@color/cyan" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center"
        android:letterSpacing="0.16"
        android:maxLines="1"
        android:singleLine="true"
        android:text="★  PERFORMANCE COMPLETE  ★"
        android:textColor="@color/gold"
        android:textSize="9sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:background="@drawable/bg_score_metric_pitch"
            android:elevation="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:maxLines="1"
                android:singleLine="true"
                android:text="PITCH"
                android:textColor="@color/cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pitchScore"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="89"
                android:textColor="@color/white"
                android:textSize="42sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="ACCURACY"
                android:textColor="@color/muted"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/scoreMedallion"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_score_circle"
            android:elevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:letterSpacing="0.15"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="FINAL SCORE"
                    android:textColor="@color/cyan"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/totalScore"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:maxLines="1"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="5"
                    android:singleLine="true"
                    android:text="87"
                    android:textColor="@color/white"
                    android:textSize="46sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="★  EXCELLENT  ★"
                    android:textColor="@color/gold"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_score_metric_rhythm"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="RHYTHM"
                    android:textColor="@color/pink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rhythmScore"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-black"
                    android:gravity="end|center_vertical"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="84"
                    android:textColor="@color/white"
                    android:textSize="28sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_score_metric_stability"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="STABILITY"
                    android:textColor="@color/violet"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/stabilityScore"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif-black"
                    android:gravity="end|center_vertical"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="88"
                    android:textColor="@color/white"
                    android:textSize="28sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/scoredSongTitle"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/bg_score_song_title"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:text="♪  Song Title — Artist  ♪"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:weightSum="3.15">

        <Button
            android:id="@+id/singAgainButton"
            style="@style/Button.ScoreSecondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="↻  Sing Again" />

        <Button
            android:id="@+id/nextSongButton"
            style="@style/Button.ScorePrimary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.15"
            android:elevation="7dp"
            android:text="Next Song  ▶" />

        <Button
            android:id="@+id/scoreHomeButton"
            style="@style/Button.ScoreSecondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="⌂  Home" />
    </LinearLayout>
</LinearLayout>
