<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OfflineKaraoke" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">@color/violet</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Text.Heading" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">18sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Muted" parent="">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Button.Primary" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Button.Secondary" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Button.CompactSecondary" parent="Button.Secondary">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Button.CompactPrimary" parent="Button.Primary">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Button.PanelControl" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_panel_control</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">16sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <style name="Button.PanelPrimary" parent="Button.PanelControl">
        <item name="android:background">@drawable/bg_panel_primary</item>
    </style>

    <style name="Button.PanelDanger" parent="Button.PanelControl">
        <item name="android:background">@drawable/bg_panel_danger</item>
    </style>

    <style name="Button.HomePrimary" parent="Button.PanelPrimary">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Button.ScoreSecondary" parent="Button.PanelControl">
        <item name="android:background">@drawable/bg_score_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <style name="Button.ScorePrimary" parent="Button.PanelPrimary">
        <item name="android:textSize">13sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
</resources>
